# Settings and references only. Never put a MySQL password in this file.
ADX_CLUSTER_URI=https://REPLACE-cluster.REPLACE-region.kusto.windows.net
ADX_INGEST_URI=https://ingest-REPLACE-cluster.REPLACE-region.kusto.windows.net
ADX_DATABASE=mysqlmonitoring

COLLECTOR_SPOOL_DIR=/var/lib/azure-mysql-monitoring/spool
COLLECTOR_SPOOL_MAX_BYTES=1073741824
COLLECTOR_SPOOL_REPLAY_SECONDS=30
COLLECTOR_SPOOL_CONFIRMATION_TIMEOUT_SECONDS=3600

ORDERS_RUN_ID=prod
ORDERS_MYSQL_USER=monitor
