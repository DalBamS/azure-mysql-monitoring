// functions.kql — stored functions shared by dashboards, alerts and the verification script.
//
// Defining these once in the cluster keeps grafana/dashboards/ thin and means a fix to the
// counter-reset handling lands everywhere at once.

// ---------------------------------------------------------------------------
// CounterRate — turn a cumulative counter into a per-second rate
// ---------------------------------------------------------------------------
// SHOW GLOBAL STATUS values are cumulative. A server restart resets them, which produces a
// large negative delta. That delta is discarded rather than plotted, but the reset itself
// stays visible in the raw table.
//
// The window parameters are startTime/endTime rather than from/to: `from` and `to` are KQL
// keywords, and using them as parameter names is rejected at function creation time.

.create-or-alter function with (docstring="Per-second rate of a cumulative counter, reset-safe", folder="mysql")
    CounterRate(metricName: string, runId: string, startTime: datetime, endTime: datetime)
{
    MysqlMetrics
    | where Timestamp between (startTime .. endTime)
    | where Metric == metricName and RunId == runId
    | order by Host asc, Timestamp asc
    | extend PrevValue = prev(Value), PrevTs = prev(Timestamp), PrevHost = prev(Host)
    | where Host == PrevHost
    | extend Seconds = datetime_diff('second', Timestamp, PrevTs)
    | where Seconds > 0
    | extend Delta = Value - PrevValue
    | where Delta >= 0                      // drop the reset boundary, not the reset itself
    | project Timestamp, Host, Tier, Metric, Rate = Delta / Seconds
}

// ---------------------------------------------------------------------------
// CollectorHealth — is the collector alive?
// ---------------------------------------------------------------------------
// A dead collector flatlines every chart, and a flatline reads as a healthy idle server.
// Absence of the heartbeat is therefore the signal, not the presence of a bad value.

.create-or-alter function with (docstring="Seconds since the last heartbeat, per host", folder="mysql")
    CollectorHealth(lookback: timespan = 15m)
{
    let V2 =
        MysqlMetricSeries
        | where Timestamp > ago(lookback)
        | where Measurement == "collector.health" and Field == "heartbeat"
        | project Timestamp, TargetId, Host, RunId;
    let V2Hosts = V2 | distinct Host, RunId;
    let Legacy =
        MysqlMetrics
        | where Timestamp > ago(lookback)
        | where Metric == "collector_heartbeat"
        | project Timestamp, TargetId=Host, Host, RunId
        | join kind=leftanti V2Hosts on Host, RunId
        | project Timestamp, TargetId, Host, RunId;
    union V2, Legacy
    | summarize LastBeat = max(Timestamp) by TargetId, Host, RunId
    | extend SecondsSinceLastBeat = datetime_diff('second', now(), LastBeat)
    | extend Status = iff(SecondsSinceLastBeat > 60, "DOWN", "OK")
}

// ---------------------------------------------------------------------------
// StorageTierComparison — the benchmark question this repo exists to answer
// ---------------------------------------------------------------------------

.create-or-alter function with (docstring="Compare one metric across two benchmark runs", folder="benchmark")
    StorageTierComparison(metricName: string, baselineRun: string, candidateRun: string)
{
    MysqlMetrics
    | where Metric == metricName and RunId in (baselineRun, candidateRun)
    | summarize Avg = avg(Value), P95 = percentile(Value, 95), Max = max(Value), Samples = count()
      by RunId, Tier, Metric
}
