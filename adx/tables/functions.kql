// functions.kql — stored functions shared by dashboards, alerts and the verification script.
//
// Defining these once in the cluster keeps grafana/dashboards/ thin and means a fix to the
// counter-reset handling lands everywhere at once.

// ---------------------------------------------------------------------------
// CounterRate — turn a cumulative counter into a per-second rate
// ---------------------------------------------------------------------------
// SHOW GLOBAL STATUS values are cumulative. A server restart resets them, which produces a
// large negative delta. That delta is discarded rather than plotted, but the reset itself
// stays visible in the raw table.
//
// The window parameters are startTime/endTime rather than from/to: `from` and `to` are KQL
// keywords, and using them as parameter names is rejected at function creation time.

.create-or-alter function with (docstring="Per-second rate of a cumulative counter, reset-safe", folder="mysql")
    CounterRate(metricName: string, runId: string, startTime: datetime, endTime: datetime)
{
    MysqlMetrics
    | where Timestamp between (startTime .. endTime)
    | where Metric == metricName and RunId == runId
    | order by Host asc, Timestamp asc
    | extend PrevValue = prev(Value), PrevTs = prev(Timestamp), PrevHost = prev(Host)
    | where Host == PrevHost
    | extend Seconds = datetime_diff('second', Timestamp, PrevTs)
    | where Seconds > 0
    | extend Delta = Value - PrevValue
    | where Delta >= 0                      // drop the reset boundary, not the reset itself
    | project Timestamp, Host, Tier, Metric, Rate = Delta / Seconds
}

.create-or-alter function with (docstring="Per-second rate and delta for one v2 catalog counter, reset-safe and Target-aware", folder="mysql/v2")
    MetricSeriesRate(measurementName: string, fieldName: string, runId: string, startTime: datetime, endTime: datetime)
{
    MysqlMetricSeries
    | where Timestamp between (startTime .. endTime)
    | where Measurement == measurementName and Field == fieldName and RunId == runId
    | order by TargetId asc, SeriesKey asc, Timestamp asc
    | serialize
    | extend PrevValue = prev(Value), PrevTimestamp = prev(Timestamp),
             PrevTargetId = prev(TargetId), PrevSeriesKey = prev(SeriesKey)
    | where TargetId == PrevTargetId and SeriesKey == PrevSeriesKey
    | extend Seconds = datetime_diff('millisecond', Timestamp, PrevTimestamp) / 1000.0
    | where Seconds > 0
    | extend Delta = Value - PrevValue
    | where Delta >= 0
    | extend Rate = Delta / Seconds
    | project Timestamp, RunId, TargetId, Host, Tier, Measurement, Field,
              SeriesKey, Tags, Delta, Seconds, Rate
}

// ---------------------------------------------------------------------------
// CollectorHealth — is the collector alive?
// ---------------------------------------------------------------------------
// A dead collector flatlines every chart, and a flatline reads as a healthy idle server.
// Absence of the heartbeat is therefore the signal, not the presence of a bad value.

.create-or-alter function with (docstring="Seconds since the last heartbeat, per host", folder="mysql")
    CollectorHealth(lookback: timespan = 15m)
{
    let V2 =
        MysqlMetricSeries
        | where Timestamp > ago(lookback)
        | where Measurement == "collector.health" and Field == "heartbeat"
        | project Timestamp, TargetId, Host, RunId;
    let V2Hosts = V2 | distinct Host, RunId;
    let Legacy =
        MysqlMetrics
        | where Timestamp > ago(lookback)
        | where Metric == "collector_heartbeat"
        | project Timestamp, TargetId=Host, Host, RunId
        | join kind=leftanti V2Hosts on Host, RunId
        | project Timestamp, TargetId, Host, RunId;
    union V2, Legacy
    | summarize LastBeat = max(Timestamp) by TargetId, Host, RunId
    | extend SecondsSinceLastBeat = datetime_diff('second', now(), LastBeat)
    | extend Status = iff(SecondsSinceLastBeat > 60, "DOWN", "OK")
}

// ---------------------------------------------------------------------------
// StorageTierComparison — the benchmark question this repo exists to answer
// ---------------------------------------------------------------------------

.create-or-alter function with (docstring="Compare one metric across two benchmark runs", folder="benchmark")
    StorageTierComparison(metricName: string, baselineRun: string, candidateRun: string)
{
    MysqlMetrics
    | where Metric == metricName and RunId in (baselineRun, candidateRun)
    | summarize Avg = avg(Value), P95 = percentile(Value, 95), Max = max(Value), Samples = count()
      by RunId, Tier, Metric
}

.create-or-alter function with (docstring="QPS, file IO, query latency/error and redo-wait summary for two v2 benchmark runs", folder="benchmark/v2")
    BenchmarkSummary(baselineRun: string, candidateRun: string, startTime: datetime, endTime: datetime)
{
    let Qps =
        union
            (MetricSeriesRate("mysql.global_status", "Queries", baselineRun, startTime, endTime)),
            (MetricSeriesRate("mysql.global_status", "Queries", candidateRun, startTime, endTime))
        | project Timestamp, RunId, TargetId, Host, Tier, Metric="QPS", Value=Rate;
    let FileOperations =
        union
            (MetricSeriesRate("mysql.file_io", "operations_total", baselineRun, startTime, endTime)),
            (MetricSeriesRate("mysql.file_io", "operations_total", candidateRun, startTime, endTime))
        | extend Mode=tostring(Tags.mode);
    let FileWait =
        union
            (MetricSeriesRate("mysql.file_io", "wait_ms_total", baselineRun, startTime, endTime)),
            (MetricSeriesRate("mysql.file_io", "wait_ms_total", candidateRun, startTime, endTime))
        | project Timestamp, RunId, TargetId, SeriesKey, WaitMsPerSecond=Rate;
    let FileIops =
        FileOperations
        | where Mode in ("read", "write")
        | summarize Value=sum(Rate) by Timestamp, RunId, TargetId, Host, Tier, Mode
        | extend Metric=iff(Mode == "read", "Read IOPS", "Write IOPS")
        | project Timestamp, RunId, TargetId, Host, Tier, Metric, Value;
    let FileThroughput =
        union
            (MetricSeriesRate("mysql.file_io", "bytes_total", baselineRun, startTime, endTime)),
            (MetricSeriesRate("mysql.file_io", "bytes_total", candidateRun, startTime, endTime))
        | extend Mode=tostring(Tags.mode)
        | where Mode in ("read", "write")
        | summarize BytesPerSecond=sum(Rate) by Timestamp, RunId, TargetId, Host, Tier, Mode
        | extend Value=BytesPerSecond / 1024.0 / 1024.0
        | extend Metric=iff(Mode == "read", "Read throughput MiB/s", "Write throughput MiB/s")
        | project Timestamp, RunId, TargetId, Host, Tier, Metric, Value;
    let FileLatency =
        FileOperations
        | where Mode in ("read", "write")
        | project Timestamp, RunId, TargetId, Host, Tier, SeriesKey, Mode, OperationsPerSecond=Rate
        | join kind=inner FileWait on Timestamp, RunId, TargetId, SeriesKey
        | summarize OperationsPerSecond=sum(OperationsPerSecond),
                    WaitMsPerSecond=sum(WaitMsPerSecond)
          by Timestamp, RunId, TargetId, Host, Tier, Mode
        | where OperationsPerSecond > 0
        | extend Value=WaitMsPerSecond / OperationsPerSecond
        | extend Metric=iff(Mode == "read", "Read latency ms", "Write latency ms")
        | project Timestamp, RunId, TargetId, Host, Tier, Metric, Value;
    let QueryTail =
        MysqlMetricSeries
        | where Timestamp between (startTime .. endTime)
        | where RunId in (baselineRun, candidateRun)
        | where Measurement == "mysql.statement_digest"
        | where Field in ("latency_p95_ms", "latency_p99_ms")
        | summarize Value=max(Value) by Timestamp, RunId, TargetId, Host, Tier, Field
        | extend Metric=iff(Field == "latency_p95_ms", "Query p95 ms", "Query p99 ms")
        | project Timestamp, RunId, TargetId, Host, Tier, Metric, Value;
    let QueryErrors =
        union
            (MetricSeriesRate("mysql.statement_digest", "errors_total", baselineRun, startTime, endTime)),
            (MetricSeriesRate("mysql.statement_digest", "errors_total", candidateRun, startTime, endTime))
        | summarize Value=sum(Rate) by Timestamp, RunId, TargetId, Host, Tier
        | extend Metric="Query errors/s"
        | project Timestamp, RunId, TargetId, Host, Tier, Metric, Value;
    let RedoLogWaits =
        union
            (MetricSeriesRate("mysql.global_status", "Innodb_log_waits", baselineRun, startTime, endTime)),
            (MetricSeriesRate("mysql.global_status", "Innodb_log_waits", candidateRun, startTime, endTime))
        | extend Metric="Redo log waits/s", Value=Rate
        | project Timestamp, RunId, TargetId, Host, Tier, Metric, Value;
    union Qps, FileIops, FileThroughput, FileLatency, QueryTail, QueryErrors, RedoLogWaits
    | summarize Avg=round(avg(Value), 3), P95=round(percentile(Value, 95), 3),
                Max=round(max(Value), 3), Samples=count()
      by Metric, RunId, TargetId, Host, Tier
}
